rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCreatorBootstrap() {
      return signedIn() && request.auth.token.email == 'creator@mass.local';
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function notBanned() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true
          || isAdmin());
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isCreatorBootstrap() && uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username;
      allow update: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if notBanned() && request.auth.uid in resource.data.members;
      allow create: if notBanned() && request.auth.uid in request.resource.data.members;
      allow update: if notBanned() && request.auth.uid in resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if notBanned() && isChatMember(chatId);
        allow create: if notBanned()
          && isChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if notBanned() && isChatMember(chatId);
        allow delete: if isAdmin() || (signedIn() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
